    "validationRules": {
      "priority": {
        "type": "string",
        "allowedValues": ["Critical", "High", "Medium", "Low"],
        "allowNull": true,
        "validation": "Must match priority enum or be documented as null"
      },
      "defectIntroducedWI": {
        "type": "string",
        "pattern": "^WI\\d+$",
        "allowNull": true,
        "validation": "Must be valid WI format or null if not applicable"
      },
      "defectIntroducedCI": {
        "type": "string",
        "allowNull": true,
        "validation": "Must be non-empty string or null if not available"
      },
      "relatedIncidents": {
        "type": "array",
        "itemPattern": "^CS\\d+$",
        "allowEmpty": true,
        "validation": "Array of CS-prefixed incident numbers or empty array"
      }
